// ============================================================================
// VS Code keybindings — companion to settings.json (VSCodeVim config).
//
// Copy/symlink this into your VS Code User keybindings, e.g.
//   ~/Library/Application Support/Code/User/keybindings.json
// ============================================================================
[
  // <leader>pv (space p v): close the file explorer and return focus to the
  // editor when the explorer is focused.
  //
  // Opening + focusing the explorer is handled by the VSCodeVim <leader>pv
  // binding in settings.json (workbench.view.explorer). That binding only fires
  // while the editor is focused; this one fires while the explorer is focused
  // (where Vim is inactive), giving a full toggle: open -> focus -> close.
  {
    "key": "space p v",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "filesExplorerFocus"
  }
]
